{
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-atlassian"
      ],
      "env": {
        "ATLASSIAN_HOST": "https://your-domain.atlassian.net",
        "ATLASSIAN_EMAIL": "user@company.com",
        "ATLASSIAN_API_TOKEN": "your_atlassian_api_token_here"
      }
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "@figma/mcp"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "your_figma_personal_access_token_here"
      }
    },
    "miro": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-miro"
      ],
      "env": {
        "MIRO_ACCESS_TOKEN": "your_miro_access_token_here"
      }
    },
    "stitch": {
      "command": "npx",
      "args": [
        "-y",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "env": {
        "STITCH_API_KEY": "AQ.Ab8RN6J9Sk_gsJOw08ktqLB6fwr-r8CPJU5sXr8H5kIQJRvAAg"
      }
    }
  }
}
